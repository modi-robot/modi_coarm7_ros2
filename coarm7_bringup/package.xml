<?xml version="1.0"?>
<package format="3">
  <name>coarm7_bringup</name><version>0.1.0</version>
  <description>CoArm7 startup, controller orchestration and local or remote RViz.</description>
  <maintainer email="1368405940@qq.com">樊成杰 (Fan Chengjie)</maintainer><license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>coarm7_description</depend>
  <depend>coarm7_moveit_config</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>controller_manager</depend>
  <depend>controller_manager_msgs</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <exec_depend>gripper_controllers</exec_depend>
  <depend>hardware_interface</depend>
  <depend>tf2_ros</depend>
  <depend>rviz2</depend>
  <depend>xacro</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <depend>python3-yaml</depend>
  <depend>random_numbers</depend>
  <!-- Hardware and diagnostics are optional runtime backends; mock needs neither. -->
  <exec_depend>coarm7_controllers</exec_depend>
  <exec_depend>openssh-client</exec_depend>
  <exec_depend>iproute2</exec_depend><exec_depend>util-linux</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
  <exec_depend>rcl_interfaces</exec_depend>
</package>
