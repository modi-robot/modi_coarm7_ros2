      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://coarm7_description/meshes/R_4C2_ee_link_4.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
  </link>
  <joint name="R_4C2_ee_link_4_joint" type="fixed">
    <origin xyz="0 0 0.147469863647503" rpy="0 0 0" />
    <parent link="R_4C2_base_link" />
    <child link="R_4C2_ee_link_4" />
    <axis xyz="0 0 1" />
  </joint>
  <!-- A massless fixed root preserves the physical pedestal inertia for KDL. -->
  <link name="coarm7_root"/>
  <joint name="coarm7_root_to_base" type="fixed">
    <parent link="coarm7_root"/><child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <xacro:arg name="initial_positions_file" default="$(find coarm7_description)/config/initial_positions.yaml"/>
  <xacro:include filename="$(find coarm7_description)/urdf/coarm7.ros2_control.xacro"/>
  <xacro:arg name="backend" default="mock"/>
  <xacro:arg name="effective_limits_file" default=""/>
  <xacro:arg name="hardware_config_file" default=""/>
  <xacro:arg name="gripper_joints" default="L_4C2_r_1_joint R_4C2_r_1_joint"/>
  <xacro:coarm7_control_system initial_positions_file="$(arg initial_positions_file)" backend="$(arg backend)" config_file="$(arg hardware_config_file)" effective_limits_file="$(arg effective_limits_file)" gripper_joints="$(arg gripper_joints)"/>

</robot>
