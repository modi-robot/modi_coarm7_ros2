<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="coarm7_control_system" params="initial_positions_file backend:='mock' config_file:='' effective_limits_file:='' gripper_joints:='L_4C2_r_1_joint R_4C2_r_1_joint'">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <ros2_control name="${dict(mock='CoArm7MockSystem', fake='CoArm7HardwareOffline', sdk='CoArm7Hardware')[backend]}" type="system">
      <hardware>
        <plugin>${dict(mock='mock_components/GenericSystem', fake='coarm7_hardware/CoArm7System', sdk='coarm7_hardware/CoArm7System')[backend]}</plugin>
        <xacro:if value="${backend == 'mock'}"><param name="calculate_dynamics">true</param></xacro:if>
        <xacro:unless value="${backend == 'mock'}"><param name="config_file">${config_file}</param></xacro:unless>
        <xacro:if value="${backend != 'mock' and effective_limits_file != ''}"><param name="effective_limits_file">${effective_limits_file}</param></xacro:if>
      </hardware>
      <joint name="L_joint1">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial_positions['L_joint1']}</param></state_interface>
        <state_interface name="velocity"/>
        <xacro:if value="${backend != 'mock' and 'L_joint1' in gripper_joints.split()}">
          <command_interface name="goal_id"/><command_interface name="stop_id"/>
          <state_interface name="feedback_stamp"/><state_interface name="stop_ack"/>
        </xacro:if>
      </joint>
      <joint name="L_joint2">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial_positions['L_joint2']}</param></state_interface>
        <state_interface name="velocity"/>
        <xacro:if value="${backend != 'mock' and 'L_joint2' in gripper_joints.split()}">
          <command_interface name="goal_id"/><command_interface name="stop_id"/>
          <state_interface name="feedback_stamp"/><state_interface name="stop_ack"/>
        </xacro:if>
      </joint>
      <joint name="L_joint3">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial_positions['L_joint3']}</param></state_interface>
        <state_interface name="velocity"/>
        <xacro:if value="${backend != 'mock' and 'L_joint3' in gripper_joints.split()}">
          <command_interface name="goal_id"/><command_interface name="stop_id"/>
          <state_interface name="feedback_stamp"/><state_interface name="stop_ack"/>
        </xacro:if>
      </joint>
      <joint name="L_joint4">
