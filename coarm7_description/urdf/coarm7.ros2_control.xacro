        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial_positions['L_4C2_r_1_joint']}</param></state_interface>
        <state_interface name="velocity"/>
        <xacro:if value="${backend != 'mock' and 'L_4C2_r_1_joint' in gripper_joints.split()}">
