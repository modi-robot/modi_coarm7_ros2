# Resolve the official binary SDK for the target architecture, never SDK sources.
include_guard(GLOBAL)
option(COARM7_DOWNLOAD_SDK "Download the pinned official SDK when none is installed" ON)
get_filename_component(_coarm7_package "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
get_filename_component(_coarm7_root "${_coarm7_package}/.." ABSOLUTE)
file(READ "${_coarm7_root}/dependencies/sdk.lock.json" _coarm7_lock)
string(JSON _coarm7_sdk_version GET "${_coarm7_lock}" version)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _coarm7_processor)
if(_coarm7_processor MATCHES "^(aarch64|arm64)$")
  set(_coarm7_arch arm64)
  set(_coarm7_machine b700)
elseif(_coarm7_processor MATCHES "^(x86_64|amd64)$")
  set(_coarm7_arch x86_64)
  set(_coarm7_machine 3e00)
else()
  message(FATAL_ERROR "Unsupported SDK target architecture: ${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "The official CoArm7 SDK requires a Linux target")
endif()

# Existing SDK packages keep offline builds and external cross-build ordering intact.
find_package(canevo_sdk_x86 ${_coarm7_sdk_version} EXACT CONFIG QUIET)
if(NOT canevo_sdk_x86_FOUND)
  if(NOT COARM7_DOWNLOAD_SDK)
    message(FATAL_ERROR "CanEvo SDK ${_coarm7_sdk_version} not found. Set canevo_sdk_x86_DIR or enable COARM7_DOWNLOAD_SDK.")
  endif()
  string(JSON _coarm7_url GET "${_coarm7_lock}" assets ${_coarm7_arch} url)
  string(JSON _coarm7_sha GET "${_coarm7_lock}" assets ${_coarm7_arch} sha256)
  include(FetchContent)
  if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
  endif()
  message(STATUS "CoArm7: fetching official SDK ${_coarm7_sdk_version} for ${_coarm7_arch}")
  FetchContent_Declare(coarm7_sdk_binary
    URL "${_coarm7_url}" URL_HASH "SHA256=${_coarm7_sha}"
    TLS_VERIFY TRUE TIMEOUT 180)
  FetchContent_GetProperties(coarm7_sdk_binary)
  if(NOT coarm7_sdk_binary_POPULATED)
    FetchContent_Populate(coarm7_sdk_binary)
  endif()
  set(COARM7_FETCHED_SDK_PREFIX "${coarm7_sdk_binary_SOURCE_DIR}" CACHE INTERNAL "Downloaded SDK install origin")
  # Explicit local lookup bypasses cross sysroot re-rooting for this target binary.
  set(canevo_sdk_x86_DIR "${coarm7_sdk_binary_SOURCE_DIR}/lib/cmake/canevo_sdk_x86"
      CACHE PATH "Official CanEvo SDK package directory" FORCE)
  find_package(canevo_sdk_x86 ${_coarm7_sdk_version} EXACT CONFIG REQUIRED
    PATHS "${canevo_sdk_x86_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
endif()

if(NOT DEFINED coarm7_sdk_binary_SOURCE_DIR AND DEFINED COARM7_FETCHED_SDK_PREFIX)
  set(coarm7_sdk_binary_SOURCE_DIR "${COARM7_FETCHED_SDK_PREFIX}")
endif()
# Reapply installation rules on reconfigure when find_package resolves a prior download.
# Otherwise a successful second configure would silently lose the SDK install rules.
if(DEFINED coarm7_sdk_binary_SOURCE_DIR AND
   canevo_sdk_x86_DIR STREQUAL "${coarm7_sdk_binary_SOURCE_DIR}/lib/cmake/canevo_sdk_x86")
  foreach(_directory include lib share)
    install(DIRECTORY "${coarm7_sdk_binary_SOURCE_DIR}/${_directory}/" DESTINATION ${_directory})
  endforeach()
  install(FILES "${coarm7_sdk_binary_SOURCE_DIR}/CHANGELOG.md" DESTINATION share/canevo_sdk_x86)
endif()

get_target_property(_coarm7_sdk_library canevo_sdk_x86::canevo_sdk_x86 IMPORTED_LOCATION_RELEASE)
if(NOT _coarm7_sdk_library)
  get_target_property(_coarm7_sdk_library canevo_sdk_x86::canevo_sdk_x86 IMPORTED_LOCATION)
endif()
if(NOT EXISTS "${_coarm7_sdk_library}")
  message(FATAL_ERROR "SDK imported library is missing: ${_coarm7_sdk_library}")
endif()
file(READ "${_coarm7_sdk_library}" _coarm7_elf LIMIT 20 HEX)
string(LENGTH "${_coarm7_elf}" _coarm7_elf_length)
if(_coarm7_elf_length LESS 40 OR NOT _coarm7_elf MATCHES "^7f454c460201")
  message(FATAL_ERROR "SDK library is not a supported ELF64 little-endian binary")
endif()
string(SUBSTRING "${_coarm7_elf}" 36 4 _coarm7_actual_machine)
if(NOT _coarm7_actual_machine STREQUAL _coarm7_machine)
  message(FATAL_ERROR "SDK architecture mismatch: target ${_coarm7_arch}, ELF e_machine=${_coarm7_actual_machine}. Select the matching SDK prefix.")
endif()
message(STATUS "CoArm7: official SDK ${_coarm7_sdk_version}, target ${_coarm7_arch}, library ${_coarm7_sdk_library}")
